    <worksheet name='05_Approval_Time_Distribution'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000'>Distribution of Approval Times</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fy2026_new_nonrenewal_permits_tableau' name='federated.1nugwql1358oaz172701m0a0vaam' />
          </datasources>
          <datasource-dependencies datasource='federated.1nugwql1358oaz172701m0a0vaam'>
            <column caption='Business Days To Approve' datatype='integer' name='[Business_Days_To_Approve]' role='measure' type='quantitative' />
            <column caption='Total Permits' datatype='integer' name='[Calculation_2108644207648768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([TrackingNumber])' />
            </column>
            <column caption='Approval Time (Business Days)' datatype='string' name='[Calculation_2108644249436161]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Business_Days_To_Approve] = 0 THEN &quot;01 | 0 days&quot;&#13;&#10;ELSEIF [Business_Days_To_Approve] &lt;= 5 THEN &quot;02 | 1-5 days&quot;&#13;&#10;ELSEIF [Business_Days_To_Approve] &lt;= 10 THEN &quot;03 | 6-10 days&quot;&#13;&#10;ELSEIF [Business_Days_To_Approve] &lt;= 15 THEN &quot;04 | 11-15 days&quot;&#13;&#10;ELSEIF [Business_Days_To_Approve] &lt;= 20 THEN &quot;05 | 16-20 days&quot;&#13;&#10;ELSEIF [Business_Days_To_Approve] &lt;= 25 THEN &quot;06 | 21-25 days&quot;&#13;&#10;ELSEIF [Business_Days_To_Approve] &lt;= 30 THEN &quot;07 | 26-30 days&quot;&#13;&#10;ELSEIF [Business_Days_To_Approve] &lt;= 60 THEN &quot;08 | 31-60 days&quot;&#13;&#10;ELSE &quot;09 | 61+ days&quot;&#13;&#10;END' />
            </column>
            <column caption='Approval Duration Group' datatype='string' name='[Calculation_2108644284649475]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Business_Days_To_Approve] &gt; 30 THEN&#13;&#10;    &quot;Over 30 business days&quot;&#13;&#10;ELSE&#13;&#10;    &quot;0-30 business days&quot;&#13;&#10;END' />
            </column>
            <column caption='Tracking Number' datatype='integer' name='[TrackingNumber]' role='dimension' type='ordinal' />
            <column caption='Ward Segment' datatype='string' name='[Ward_Segment]' role='dimension' type='nominal' />
            <column caption='Work Category' datatype='string' name='[Work_Category]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2108644249436161]' derivation='None' name='[none:Calculation_2108644249436161:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2108644284649475]' derivation='None' name='[none:Calculation_2108644284649475:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2108644207648768]' derivation='User' name='[pcto:usr:Calculation_2108644207648768:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' type='PctTotal' />
            </column-instance>
            <column-instance column='[Calculation_2108644207648768]' derivation='User' name='[usr:Calculation_2108644207648768:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1nugwql1358oaz172701m0a0vaam].[Action (Ward Segment)]'>
            <groupfilter function='level-members' level='[Ward_Segment]' user:ui-action-filter='[Action1_EDAB3113C6084C32B2E80CCDF5A11645]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1nugwql1358oaz172701m0a0vaam].[Action (Work Category)]'>
            <groupfilter function='level-members' level='[Work_Category]' user:ui-action-filter='[Action2_58BE804BB3BA4FD9B91212FD7E790C49]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.1nugwql1358oaz172701m0a0vaam].[Action (Ward Segment)]</column>
            <column>[federated.1nugwql1358oaz172701m0a0vaam].[Action (Work Category)]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
