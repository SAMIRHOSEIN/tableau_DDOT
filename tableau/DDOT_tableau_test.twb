            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontcolor='#757575'>Approval Time Band:</run>
                <run bold='true'><![CDATA[<[federated.1nugwql1358oaz172701m0a0vaam].[none:Calculation_2108644249436161:nk]> ]]></run>
                <run>Æ&#10;</run>
                <run fontcolor='#757575'>Number of Permits&#9;</run>
                <run bold='true'><![CDATA[<[federated.1nugwql1358oaz172701m0a0vaam].[pcto:usr:Calculation_2108644207648768:qk]>]]></run>
